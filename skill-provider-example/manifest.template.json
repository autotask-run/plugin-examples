{
  "schema_version": "autotask.plugin.v1",
  "identity": {
    "plugin_id": "user-7/skill-catalog",
    "name": "skill-catalog",
    "description": "A remote MCP Skill Provider with a deterministic complete catalog.",
    "version": "1.0.0",
    "author": {"name": "Example author"},
    "repository": "https://github.com/autotask-run/plugin-examples",
    "license": "MIT"
  },
  "classification": {"plugin_kind": "skill_provider", "source_kind": "native", "runtime_kinds": ["mcp"]},
  "runtimes": [{"runtime_id": "skill-catalog", "kind": "mcp", "protocol": "mcp"}],
  "permissions": [{"permission": "network:skills.example.com"}],
  "capabilities": {
    "skill_providers": [{
      "name": "skill_catalog",
      "title": "Remote Skill Catalog",
      "description": "Synchronize bounded text Skill snapshots from a remote catalog.",
      "runtime_id": "skill-catalog",
      "runtime_kind": "mcp",
      "support_level": "executable_existing_runtime",
      "risk_level": "medium",
      "permissions": ["network:skills.example.com"],
      "provider_id": "example-skill-catalog",
      "source_kinds": ["skill_catalog"],
      "config_schema": {"type": "object", "properties": {}, "additionalProperties": false},
      "operations": {
        "validate_config": "skill_validate_config",
        "sync": "skill_sync",
        "get_content": "skill_get_content"
      },
      "sync_modes": ["full"],
      "max_items_default": 100,
      "metadata": {
        "protocol": "autotask.skill-provider.v1",
        "mcp_server": {
          "name": "example-skill-catalog",
          "config": {"url": "https://skills.example.com/provider-mcp", "transport": "streamable-http"},
          "auth": {"type": "api_key", "header": "Authorization", "prefix": "Bearer "}
        }
      }
    }]
  }
}
